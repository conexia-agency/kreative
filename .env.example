# ---------------------------------------------------------------------------
# Kreative — variables d'environnement
#
# Chargement (a faire avant une session de travail) :
#     set -a && source .env && set +a
#
# Regle du projet : une cle ne s'ecrit jamais dans un livrable, un message,
# une capture ou un commit. On la reference par son nom ($ZITE_API_KEY).
# ---------------------------------------------------------------------------

# --- Formulaires ------------------------------------------------------------
# Zite Forms : point d'entree de la chaine (pipeline/zite.py -> api.zite.com).
# REQUIS : kreative.py et orchestrateur.py refusent de tourner sans.
ZITE_API_KEY=""

# Fillout : renseignee et verifiee (8 formulaires accessibles).
FILLOUT_API_KEY=""

# --- Chemins de travail -----------------------------------------------------
# Dossier de travail (commandes clients). Defaut attendu : $HOME/Kreative
KREATIVE_TRAVAIL=""

# Dossier de depot des livraisons finales (pipeline/livrer.py)
KREATIVE_LIVRAISONS=""

# --- Notifications ----------------------------------------------------------
# Webhook appele en fin de livraison (pipeline/livrer.py). Optionnel.
KREATIVE_NOTIF_WEBHOOK=""

# --- Plateforme de revue (Conexia) ------------------------------------------
# Les 5 sont exiges ensemble par pipeline/publier.py : sans elles, la chaine
# s'arrete a la page de suivi locale. Fournies a l'ouverture du compte.
PUBLIE_SITE=""
PUBLIE_SUPABASE_URL=""
PUBLIE_SUPABASE_ANON_KEY=""
PUBLIE_EMAIL=""
PUBLIE_PASSWORD=""

# --- Higgsfield -------------------------------------------------------------
# Rien a poser ici : le CLI gere son propre token de session
# (higgsfield auth login). Plafond conseille : 120 credits par commande.
